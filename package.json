{
  "name": "intrack",
  "private": true,
  "version": "0.7.2",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:rate-limit": "deno test --lock=deno.lock supabase/tests/rate-limit-test.ts supabase/tests/rate-limit-handler-test.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test": "npm run test:rate-limit && npm run test:unit",
    "test:quiet": "deno test --quiet --lock=deno.lock supabase/tests/rate-limit-test.ts supabase/tests/rate-limit-handler-test.ts && vitest run --config vitest.config.ts --reporter=agent",
    "test:cors-smoke": "deno test --allow-net --allow-env supabase/tests/cors-smoke-test.ts",
    "test:e2e": "playwright test",
    "sb:local:generate:schema": "npx supabase gen types typescript --local > src/schema.ts && oxfmt src/schema.ts",
    "sb:local:start": "npx supabase start",
    "sb:local:db:seed:users": "node supabase/seed-users.js",
    "sb:local:stop": "npx supabase stop",
    "sb:local:status": "npx supabase status",
    "sb:local:db:recreate": "npx supabase db reset",
    "sb:local:functions:deploy": "npx supabase functions serve rate-limit &",
    "sb:local:db:pull": "npx supabase db pull",
    "sb:local:db:diff": "npx supabase db diff",
    "sb:local:db:migration:new": "npx supabase migration new",
    "generate:dummy:consultations": "tsx scripts/generate_dummy_consultations.ts"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.3",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-query-devtools": "^5.105.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "read-excel-file": "^9.3.14",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "write-excel-file": "^4.1.1",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/zxcvbn": "^4.4.5",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.77.0",
    "shadcn": "^4.11.0",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
